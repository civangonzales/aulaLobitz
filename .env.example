# Password reset: configure SMTP to deliver real emails.
# Without EMAIL_HOST, development prints emails in the server terminal.
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=True
EMAIL_USE_SSL=False
DEFAULT_FROM_EMAIL=aulaLobitz <no-reply@example.com>
